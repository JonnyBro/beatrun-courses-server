HOST=0.0.0.0
PORT=6547
# false enables the /auth/dev test accounts and request logging
PRODUCTION=true
# true when running behind nginx, Cloudflare and the like
BEHIND_PROXY=false

MONGO_URL=mongodb://localhost:27017/courses
# Where the site is opened from, Steam login comes back here. http://localhost:5173 for development
DOMAIN=http://localhost:6547
# At least 32 characters, `openssl rand -base64 48`
SESSION_SECRET=
# Optional, without it the site doesn't get Steam avatars and names
STEAM_API_KEY=
